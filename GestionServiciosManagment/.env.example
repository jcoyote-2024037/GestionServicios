# ============================================
# GestionServicios - Backend Environment Variables
# ============================================
# Copia este archivo como .env y completa los valores

# ── Entorno ──────────────────────────────────
NODE_ENV=production
PORT=3006

# ── MongoDB Atlas ────────────────────────────
# URI de conexión a MongoDB (producción usar MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/gestionservicio?retryWrites=true&w=majority

# ── PostgreSQL (Render/Neon) ─────────────────
DB_NAME=gestionservicio
DB_USER=usuario
DB_PASS=password
DB_HOST=localhost
DB_PORT=5432

# ── JWT ──────────────────────────────────────
JWT_SECRET=MyVerySecretKeyForJWTTokenAuthenticationWith256Bits
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# ── CORS ─────────────────────────────────────
# Orígenes permitidos separados por coma (sin espacios)
# Ejemplo: https://tu-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=https://tu-frontend.vercel.app

# ── Frontend URL ─────────────────────────────
# URL del frontend (para enlaces en correos)
FRONTEND_URL=https://tu-frontend.vercel.app

# ── SMTP (Gmail / SendGrid) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=correo@gmail.com
SMTP_PASSWORD=app_password_16_caracteres
SMTP_FROM_EMAIL=correo@gmail.com
SMTP_FROM_NAME=Gestión Servicios

# ── IA (opcional) ────────────────────────────
GROQ_API_KEY=your_groq_api_key
